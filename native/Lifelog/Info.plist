<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Lifelog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>Lifelog reads steps and sleep to add daily context to your journal.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Lifelog does not write health data.</string>
	<key>NSCameraUsageDescription</key>
	<string>Lifelog uses the camera only when you choose to take a photo or video for your journal. Captures are stored encrypted on this device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lifelog records audio only while you are making a voice note. Recordings are stored encrypted on this device.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lifelog can turn a voice note into text so you can read it later. Transcription runs on this device whenever your language supports it.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Lifelog can use Face ID to unlock the screen lock instead of typing your PIN.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lifelog uses your location to label saved places and visits.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lifelog can record significant visits so you can see where your day went.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
